# Copy this file to .env and fill in the values
# NEVER commit your real .env file

# Your wallet private key (without 0x prefix is also fine in most cases)
PRIVATE_KEY=your_private_key_here

# Base Sepolia RPC URL
# You can use the public one or better ones from Alchemy / Infura / QuickNode
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Optional: if you also want Sepolia
SEPOLIA_RPC_URL=
SEPOLIA_PRIVATE_KEY=
